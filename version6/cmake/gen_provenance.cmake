# Writes provenance.h: git commit, dirty flag, compiler, flags, platform.
# Run at build time (see CMakeLists.txt) so the hash is the one the binary was built from.
find_package(Git QUIET)
set(HASH "unknown")
set(DIRTY "unknown")
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
                  WORKING_DIRECTORY ${SRC_DIR} OUTPUT_VARIABLE HASH
                  OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
  if(NOT rc EQUAL 0)
    set(HASH "unknown")
  else()
    # Tracked files only: results written during a sweep must not mark the build dirty.
    execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
                    WORKING_DIRECTORY ${SRC_DIR} OUTPUT_VARIABLE ST
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(ST STREQUAL "")
      set(DIRTY "0")
    else()
      set(DIRTY "1")
    endif()
  endif()
endif()
set(CONTENT "// generated by cmake/gen_provenance.cmake -- do not edit
#pragma once
#define V6_GIT_HASH \"${HASH}\"
#define V6_GIT_DIRTY \"${DIRTY}\"
#define V6_COMPILER \"${COMPILER}\"
#define V6_BUILD_FLAGS \"${FLAGS}\"
#define V6_PLATFORM \"${PLATFORM}\"
")
if(EXISTS ${OUT})
  file(READ ${OUT} OLD)
else()
  set(OLD "")
endif()
if(NOT OLD STREQUAL CONTENT)
  file(WRITE ${OUT} "${CONTENT}")
endif()
